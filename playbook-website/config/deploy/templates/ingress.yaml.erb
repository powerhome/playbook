<% urls = ingress["hosts"].map { |host| URI.parse(host) } %>
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: playbook-traefik
  labels:
    app: playbook
  <% if ingress["issueCert"] || environment == 'production' %>
  annotations:
    <% if ingress["issueCert"] %>
    cert-manager.io/cluster-issuer: production-certs
    <% end %>
    <% if environment == 'production' %>
    traefik.ingress.kubernetes.io/router.entrypoints: https,https-public
    <% end %>
  <% end %>
spec:
  ingressClassName: traefik
  tls:
  - hosts:
      <% urls.each do |url| %>
      - <%= url.host %>
      <% end %>
    secretName: playbook-tls
  rules:
    <% urls.each do |url| %>
    - host: <%= url.host %>
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: playbook
                port:
                  number: 80
    <% end %>
