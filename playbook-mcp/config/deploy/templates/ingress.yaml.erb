<%
  urls = ingress["hosts"].map { |host| URI.parse(host) }
  # PR stacks (issueCert: false) share the pre-issued wildcard secret used by the website.
  # Staging/production issue a dedicated cert into playbook-mcp-tls.
  tls_secret = ingress["issueCert"] ? "playbook-mcp-tls" : "playbook-tls"
%>
# VPN-only in every environment. Two Ingresses while the cluster moves from
# nginx to Traefik (same pattern as the website): DNS still routes review and
# beta hosts to nginx, so a Traefik-only Ingress returns nginx's default 404.
# Never add nginx `whitelist-source-range` or Traefik `https-public` here, and
# keep these separate from the website Ingresses (public in production).
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: playbook-mcp
  labels:
    app: playbook-mcp
  annotations:
    kubernetes.io/ingress.class: nginx
    <% if ingress["issueCert"] %>
    cert-manager.io/cluster-issuer: production-certs
    <% end %>
    # Streamable HTTP: stream responses instead of buffering them.
    nginx.ingress.kubernetes.io/proxy-buffering: "off"
    nginx.ingress.kubernetes.io/proxy-read-timeout: "3600"
spec:
  tls:
  - hosts:
      <% urls.each do |url| %>
      - <%= url.host %>
      <% end %>
    secretName: <%= tls_secret %>
  rules:
    <% urls.each do |url| %>
    - host: <%= url.host %>
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: playbook-mcp
                port:
                  number: 80
    <% end %>
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: playbook-mcp-traefik
  labels:
    app: playbook-mcp
spec:
  ingressClassName: traefik
  tls:
  - hosts:
      <% urls.each do |url| %>
      - <%= url.host %>
      <% end %>
    secretName: <%= tls_secret %>
  rules:
    <% urls.each do |url| %>
    - host: <%= url.host %>
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: playbook-mcp
                port:
                  number: 80
    <% end %>
