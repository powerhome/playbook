<%
  urls = ingress["hosts"].map { |host| URI.parse(host) }
  # PR stacks (issueCert: false) share the pre-issued wildcard secret used by the website.
  # Staging/production issue a dedicated cert into playbook-mcp-tls.
  tls_secret = ingress["issueCert"] ? "playbook-mcp-tls" : "playbook-tls"
%>
# VPN-only in every environment: Traefik's default entrypoints on PAC are
# VPN-scoped. Do not add the https-public entrypoint or a source-range
# whitelist, and keep this separate from the website Ingress (public in production).
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: playbook-mcp
  labels:
    app: playbook-mcp
  <% if ingress["issueCert"] %>
  annotations:
    cert-manager.io/cluster-issuer: production-certs
  <% end %>
spec:
  ingressClassName: traefik
  tls:
  - hosts:
      <% urls.each do |url| %>
      - <%= url.host %>
      <% end %>
    secretName: <%= tls_secret %>
  rules:
    <% urls.each do |url| %>
    - host: <%= url.host %>
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: playbook-mcp
                port:
                  number: 80
    <% end %>
