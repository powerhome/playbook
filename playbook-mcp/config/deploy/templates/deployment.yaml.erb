apiVersion: apps/v1
kind: Deployment
metadata:
  name: playbook-mcp
  labels:
    app: playbook-mcp
  annotations:
    krane.shopify.io/required-rollout: "full"
<%
  replica_count = 1
  replica_count = replicas if defined?(replicas) && !replicas.nil?
  replica_count = appConfig["replicas"] if defined?(appConfig) && appConfig.is_a?(Hash) && appConfig["replicas"]
  asset_base = ""
  if defined?(ingress) && ingress.is_a?(Hash) && ingress["hosts"].is_a?(Array) && ingress["hosts"].first
    asset_base = ingress["hosts"].first.to_s.sub(%r{/\z}, "")
  end
%>
spec:
  replicas: <%= replica_count %>
  # RenderStore is process-local, so two ready pods would split renders: /mcp and
  # /ui/:id are different clients and cannot be pinned to the same pod. Stop the
  # old pod before starting the new one (brief downtime, no overlap).
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: playbook-mcp
  template:
    metadata:
      labels:
        app: playbook-mcp
    spec:
      containers:
        - name: playbook-mcp
          image: "image-registry.powerapp.cloud/playbook/playbook-mcp:<%= image_tag %>"
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 3099
          env:
            - name: PORT
              value: "3099"
            - name: SECRET_KEY_BASE
              valueFrom:
                secretKeyRef:
                  name: playbook-mcp
                  key: secret-key-base
            - name: RACK_ENV
              value: <%= appConfig["rackEnv"] %>
            - name: RAILS_ENV
              value: <%= appConfig["railsEnv"] %>
            - name: RAILS_SERVE_STATIC_FILES
              value: "true"
            - name: RAILS_LOG_TO_STDOUT
              value: "true"
            - name: PLAYBOOK_MCP_DISABLE_HOST_CHECK
              value: "1"
            - name: PLAYBOOK_MCP_ASSET_BASE_URL
              value: "<%= asset_base %>"
            - name: PLAYBOOK_MCP_RATE_LIMIT_MAX
              value: "60"
            - name: PLAYBOOK_MCP_RATE_LIMIT_WINDOW
              value: "60"
            - name: PLAYBOOK_MCP_KEYS
              valueFrom:
                secretKeyRef:
                  name: playbook-mcp
                  key: consumer-keys
            - name: PLAYBOOK_MCP_MAX_PROPS_BYTES
              value: "65536"
          livenessProbe:
            httpGet:
              path: /health
              port: 3099
            initialDelaySeconds: 20
            timeoutSeconds: 5
          readinessProbe:
            httpGet:
              path: /health
              port: 3099
            initialDelaySeconds: 10
            timeoutSeconds: 5
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: "1"
              memory: 1Gi
