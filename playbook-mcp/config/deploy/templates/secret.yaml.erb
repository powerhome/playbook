<% require "base64" %>
<%
  secret_key = nil
  secret_key = appConfig["secretKeyBase"] if defined?(appConfig) && appConfig.is_a?(Hash)
  secret_key = secretKeyBase if secret_key.to_s.empty? && defined?(secretKeyBase)
  raise "secretKeyBase is required for playbook-mcp deploy" if secret_key.to_s.empty?

  allowlist_value = nil
  allowlist_value = appConfig["allowlist"] if defined?(appConfig) && appConfig.is_a?(Hash) && !appConfig["allowlist"].to_s.empty?
  allowlist_value = allowlist if allowlist_value.to_s.empty? && defined?(allowlist) && !allowlist.to_s.empty?
  raise "allowlist is required for playbook-mcp deploy (use '*' only for VPN review stacks)" if allowlist_value.to_s.empty?
%>
apiVersion: v1
kind: Secret
metadata:
  name: playbook-mcp
  labels:
    app: playbook-mcp
type: Opaque
data:
  secret-key-base: <%= Base64.strict_encode64(secret_key.to_s) %>
  allowlist: <%= Base64.strict_encode64(allowlist_value.to_s) %>
