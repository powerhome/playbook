<% require "base64" %>
<%
  secret_key = nil
  secret_key = appConfig["secretKeyBase"] if defined?(appConfig) && appConfig.is_a?(Hash)
  secret_key = secretKeyBase if secret_key.to_s.empty? && defined?(secretKeyBase)
  raise "secretKeyBase is required for playbook-mcp deploy" if secret_key.to_s.empty?

  consumer_keys = nil
  consumer_keys = appConfig["consumerKeys"] if defined?(appConfig) && appConfig.is_a?(Hash)
  consumer_keys = consumerKeys if consumer_keys.to_s.empty? && defined?(consumerKeys)
  raise "consumerKeys is required for playbook-mcp deploy (consumer:key pairs)" if consumer_keys.to_s.empty?
%>
apiVersion: v1
kind: Secret
metadata:
  name: playbook-mcp
  labels:
    app: playbook-mcp
type: Opaque
data:
  secret-key-base: <%= Base64.strict_encode64(secret_key.to_s) %>
  consumer-keys: <%= Base64.strict_encode64(consumer_keys.to_s) %>
