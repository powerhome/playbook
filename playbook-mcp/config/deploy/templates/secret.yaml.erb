apiVersion: v1
kind: Secret
metadata:
  name: playbook-mcp
  labels:
    app: playbook-mcp
type: Opaque
stringData:
  secret-key-base: "<%= secrets.fetch("secret-key-base") %>"
  # Required: comma-separated LibreChat/DW egress IPs (production refuses empty allowlist).
  allowlist: "<%= secrets.fetch("allowlist") %>"
