#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
bundle check || bundle install
mkdir -p tmp/pids log vendor/chart-peers
if [[ "${PLAYBOOK_MCP_SKIP_VENDOR_CHARTS:-}" != "1" ]]; then
  if [[ ! -s vendor/chart-peers/playbook-charts.js ]] || [[ ! -s vendor/chart-peers/playbook-rails.js ]]; then
    echo "Building self-contained iframe IIFEs (esbuild) for MCP-UI..."
    bin/vendor_chart_peers || echo "WARN: iframe bundles failed; table/chart JS will be non-interactive until bin/vendor_chart_peers succeeds"
  fi
fi
echo "playbook-mcp ready. Start with: bundle exec puma -C config/puma.rb"
