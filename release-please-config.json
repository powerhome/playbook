{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": false,
  "skip-changelog": true,
  "always-update": true,
  "draft-pull-request": true,
  "pull-request-title-pattern": "chore(release): Version bump ${version}",
  "extra-label": "Inactive RC,milano",
  "packages": {
    ".": {
      "extra-files": [
        "playbook/lib/playbook/version.rb",
        {
          "type": "json",
          "path": "playbook/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
