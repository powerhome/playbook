<%= pb_rails("pill", props: { margin_right: "xs", variant: "success" }) do %>
  <%= pb_rails("flex", props: { align_items: "center" }) do %>
    <%= pb_rails("title", props: { color: "success", size: 4, tag: "div", text: "Complete" }) %>
    <%= pb_rails("icon", props: { color: "success", icon: "check", size: "sm" }) %>
  <% end %>
<% end %>
<%= pb_rails("pill", props: { margin_right: "xs", variant: "warning" }) do %>
  <%= pb_rails("icon", props: { color: "warning", icon: "exclamation-triangle", size: "sm" }) %>
<% end %>
