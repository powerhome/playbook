{
  "$schema": "https://playbook.powerapp.cloud/schemas/kit-schema.json",
  "name": "Image",
  "description": "Image component",
  "platforms": [
    "react",
    "rails"
  ],
  "props": {
    "alt": {
      "type": "string",
      "platforms": [
        "react",
        "rails"
      ],
      "default": ""
    },
    "onError": {
      "type": {
        "react": "function",
        "rails": "string"
      },
      "platforms": [
        "react",
        "rails"
      ],
      "default": null
    },
    "size": {
      "type": "enum",
      "platforms": [
        "react",
        "rails"
      ],
      "values": {
        "react": [
          "xs",
          "sm",
          "md",
          "lg",
          "xl"
        ],
        "rails": [
          "xs",
          "sm",
          "md",
          "lg",
          "xl",
          "none"
        ]
      },
      "default": {
        "react": "",
        "rails": "none"
      }
    },
    "rounded": {
      "type": "boolean",
      "platforms": [
        "react",
        "rails"
      ],
      "default": false
    },
    "transition": {
      "type": "enum",
      "platforms": [
        "react",
        "rails"
      ],
      "values": {
        "react": [
          "blur",
          "fade",
          "scale"
        ],
        "rails": [
          "blur",
          "fade",
          "scale",
          "none"
        ]
      },
      "default": "fade"
    },
    "url": {
      "type": "string",
      "platforms": [
        "react",
        "rails"
      ],
      "default": ""
    }
  },
  "globalProps": true,
  "globalEventProps": true,
  "usage": {
    "react": {
      "import": "import { Image } from 'playbook-ui'",
      "example": "<Image size=\"xs\" transition=\"blur\"></Image>"
    },
    "rails": {
      "import": null,
      "example": "<%= pb_rails(\"image\", props: { size: \"xs\", transition: \"blur\" }) %>"
    }
  }
}
