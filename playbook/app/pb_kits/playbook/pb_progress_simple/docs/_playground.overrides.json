{
  "defaults": {
    "align": "left",
    "muted": false,
    "variant": "default",
    "width": "100%"
  },
  "groups": [
    { "name": "Content", "props": ["percent", "value", "max"] },
    { "name": "Behavior", "props": ["align"] },
    { "name": "Appearance", "props": ["variant", "muted", "width", "dark"] }
  ],
  "presets": [
    { "name": "0%", "platforms": ["react"], "props": { "percent": "0" } },
    { "name": "50%", "platforms": ["react"], "props": { "percent": "50" } },
    { "name": "100%", "platforms": ["react"], "props": { "percent": "100" } },
    {
      "name": "variant: positive",
      "platforms": ["react"],
      "props": { "percent": "75", "variant": "positive" }
    },
    {
      "name": "Muted",
      "platforms": ["react"],
      "props": { "muted": true, "percent": "50" }
    },
    {
      "name": "Value of Max",
      "props": { "value": 2, "max": 10 }
    },
    {
      "name": "Fixed Width",
      "platforms": ["react"],
      "props": { "percent": "40", "width": "120px" }
    },
    {
      "name": "Centered",
      "platforms": ["react"],
      "props": { "percent": "60", "align": "center" }
    },
    { "name": "Empty (0%)", "platforms": ["rails"], "props": { "percent": 0 } },
    { "name": "Half (50%)", "platforms": ["rails"], "props": { "percent": 50 } },
    { "name": "Complete (100%)", "platforms": ["rails"], "props": { "percent": 100 } },
    {
      "name": "Positive variant",
      "platforms": ["rails"],
      "props": { "percent": 75, "variant": "positive" }
    },
    {
      "name": "Muted bar",
      "platforms": ["rails"],
      "props": { "muted": true, "percent": 50 }
    },
    {
      "name": "Fixed width bar",
      "platforms": ["rails"],
      "props": { "percent": 40, "width": "120px" }
    },
    {
      "name": "Centered bar",
      "platforms": ["rails"],
      "props": { "percent": 60, "align": "center" }
    }
  ],
  "conditionals": {},
  "hints": {
    "required_progress": {
      "message": "Set percent, or set both value and max. Percent wins when both are set.",
      "type": "info"
    },
    "percent": {
      "when": { "percent": "50" },
      "message": "Percent accepts a number-like string and renders that width directly.",
      "type": "info"
    },
    "value_max": {
      "presetName": "Value of Max",
      "message": "Use value with max when the progress should be calculated from a ratio.",
      "type": "info"
    },
    "width": {
      "when": { "width": "120px" },
      "message": "Width controls the progress bar container; percent still controls the fill.",
      "type": "info"
    },
    "variant: positive": {
      "when": { "variant": "positive" },
      "message": "Use the variant prop to set the color of the progress bar.",
      "type": "info"
    }
  }
}
