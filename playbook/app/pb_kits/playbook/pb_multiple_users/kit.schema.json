{
  "$schema": "https://playbook.powerapp.cloud/schemas/kit-schema.json",
  "name": "MultipleUsers",
  "description": "MultipleUsers component",
  "platforms": [
    "react",
    "rails"
  ],
  "props": {
    "dark": {
      "type": "boolean",
      "platforms": [
        "react"
      ],
      "default": false
    },
    "maxDisplayedUsers": {
      "type": "number",
      "platforms": [
        "react"
      ],
      "default": 4
    },
    "reverse": {
      "type": "boolean",
      "platforms": [
        "react",
        "rails"
      ],
      "default": false
    },
    "size": {
      "type": "enum",
      "platforms": [
        "react",
        "rails"
      ],
      "values": {
        "react": [
          "md",
          "lg",
          "sm",
          "xl",
          "xs",
          "xxs"
        ],
        "rails": [
          "xxs",
          "xs"
        ]
      },
      "default": "xs"
    },
    "withTooltip": {
      "type": "boolean",
      "platforms": [
        "react",
        "rails"
      ],
      "default": false
    },
    "users": {
      "type": "array",
      "platforms": [
        "react",
        "rails"
      ]
    }
  },
  "globalProps": true,
  "globalEventProps": true,
  "usage": {
    "react": {
      "import": "import { MultipleUsers } from 'playbook-ui'",
      "example": "<MultipleUsers size=\"md\"></MultipleUsers>"
    },
    "rails": {
      "import": null,
      "example": "<%= pb_rails(\"multiple_users\", props: { size: \"xxs\" }) %>"
    }
  }
}
