{
  "template": "<StatValue{{props}} />",
  "propTargets": {},
  "defaults": {
    "value": 0
  },
  "groups": [
    {
      "name": "Content",
      "props": [
        "value",
        "unit"
      ]
    }
  ],
  "presets": [
    {
      "name": "Default",
      "props": {
        "value": 1428,
        "unit": "hrs"
      }
    },
    {
      "name": "Value only",
      "props": {
        "value": 1428
      }
    },
    {
      "name": "Formatted string",
      "platforms": [
        "react"
      ],
      "props": {
        "value": "2,000",
        "unit": "views"
      }
    },
    {
      "name": "Zero state",
      "props": {
        "value": 0,
        "unit": "tasks"
      }
    },
    {
      "name": "With precision",
      "platforms": [
        "rails"
      ],
      "props": {
        "value": 1428.5,
        "precision": 2,
        "unit": "hrs"
      }
    }
  ],
  "conditionals": {},
  "hints": {
    "default": {
      "presetName": "Default",
      "message": "Default pairs a numeric value with a compact unit label.",
      "type": "info"
    },
    "value_only": {
      "presetName": "Value only",
      "message": "Value only renders the stat without the smaller unit text.",
      "type": "info"
    },
    "formatted_string": {
      "presetName": "Formatted string",
      "message": "Formatted string accepts preformatted values when commas or labels are already prepared.",
      "type": "info"
    },
    "zero_state": {
      "presetName": "Zero state",
      "message": "Zero state keeps the unit visible while showing an empty or reset metric.",
      "type": "info"
    },
    "with_precision": {
      "presetName": "With precision",
      "message": "Precision fixes the number of decimal places shown on Rails.",
      "type": "info"
    }
  }
}
