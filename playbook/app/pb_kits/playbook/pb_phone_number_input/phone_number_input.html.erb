<%= pb_content_tag(:div, id: nil) do %>
  <%= pb_rails("text_input", props: {
    dark: object.dark,
    disabled: object.disabled,
    error: object.error.presence,
    id: object.id,
    input_options: { data: object.text_input_data },
    label: object.label,
    name: object.name,
    required: object.required,
    required_indicator: object.required_indicator,
    type: "tel",
    value: object.value,
  }) %>
<% end %>
