<%= pb_rails("title", props: { text: "Demo 1: Mask + Add On Hidden Input/Submission"})%>
<%= pb_form_with(scope: :transaction, method: :get, url: "", validate: true, data: { addon_currency_example: true }) do |form| %>
  <%= pb_rails("text_input", props: {
    label: "pb_rails Text Input Currency Mask + Add On",
    name: "transaction[amount]",
    id: "transaction_amount",
    mask: "currency",
    add_on: { icon: "dollar-sign", alignment: "left", border: false },
    placeholder: "$0.00",
    required: true,
  }) %>
  <%= form.text_field :fee, props: { label: "Form Builder Text Input Currency Mask + Add On", placeholder: "$0.00", mask: "currency", add_on: { icon: "percent", alignment: "right", border: true }, required: true } %>

  <%= pb_rails("text_input", props: {
    label: "pb_rails Text Input ZIP Code Mask + Add On",
    name: "transaction[zip_code]",
    id: "transaction_zip_code",
    mask: "zip_code",
    add_on: { icon: "map-marker-alt", alignment: "left", border: false },
    placeholder: "12345",
    required: true,
  }) %>
  <%= form.text_field :zip_code_builder, props: { label: "Form Builder Text Input ZIP Code Mask + Add On", mask: "zip_code", add_on: { icon: "map-marker-alt", alignment: "right", border: true }, placeholder: "12345", required: true } %>

  <%= pb_rails("text_input", props: {
    label: "pb_rails Text Input Postal Code Mask + Add On",
    name: "transaction[postal_code]",
    id: "transaction_postal_code",
    mask: "postal_code",
    add_on: { icon: "mail-bulk", alignment: "left", border: false },
    placeholder: "12345-6789",
    required: true,
  }) %>
  <%= form.text_field :postal_code_builder, props: { label: "Form Builder Text Input Postal Code Mask + Add On", mask: "postal_code", add_on: { icon: "mail-bulk", alignment: "right", border: true }, placeholder: "12345-6789", required: true } %>

  <%= pb_rails("text_input", props: {
    label: "pb_rails Text Input SSN Mask + Add On",
    name: "transaction[ssn]",
    id: "transaction_ssn",
    mask: "ssn",
    add_on: { icon: "id-badge", alignment: "left", border: false },
    placeholder: "123-45-6789",
    required: true,
  }) %>
  <%= form.text_field :ssn_builder, props: { label: "Form Builder Text Input SSN Mask + Add On", mask: "ssn", add_on: { icon: "id-badge", alignment: "right", border: true }, placeholder: "123-45-6789", required: true } %>

  <%= pb_rails("text_input", props: {
    label: "pb_rails Text Input Credit Card Mask + Add On",
    name: "transaction[credit_card]",
    id: "transaction_credit_card",
    mask: "credit_card",
    add_on: { icon: "credit-card", alignment: "left", border: false },
    placeholder: "1234 5678 9012 3456",
    required: true,
  }) %>
  <%= form.text_field :credit_card_builder, props: { label: "Form Builder Text Input Credit Card Mask + Add On", mask: "credit_card", add_on: { icon: "credit-card", alignment: "right", border: true }, placeholder: "1234 5678 9012 3456", required: true } %>

  <%= pb_rails("text_input", props: {
    label: "pb_rails Text Input CVV Mask + Add On",
    name: "transaction[cvv]",
    id: "transaction_cvv",
    mask: "cvv",
    add_on: { icon: "lock", alignment: "left", border: false },
    placeholder: "123",
    required: true,
  }) %>
  <%= form.text_field :cvv_builder, props: { label: "Form Builder Text Input CVV Mask + Add On", mask: "cvv", add_on: { icon: "lock", alignment: "right", border: true }, placeholder: "123", required: true } %>

  <%= form.text_field :reference, props: { label: "Form Builder Text Input Add On NO MASK", add_on: { icon: "frog", alignment: "left", border: true }, required: true } %>

  <%= form.actions do |action| %>
    <%= action.submit %>
    <%= action.button props: { type: "reset", text: "Cancel", variant: "secondary" } %>
  <% end %>
<% end %>
<%= pb_rails("card", props: { margin_top: "sm" }) do %>
  <%= pb_rails("caption", props: { text: "Submitted form data", margin_bottom: "xs" }) %>
  <%= pb_rails("body", props: { text: "Submit the form to list every param the browser sends below. The same data is logged to the console. All fields are required." }) %>
  <pre data-addon-currency-example-output></pre>
<% end %>

<%= javascript_tag defer: "defer" do %>
  document.addEventListener("submit", function(event) {
    const form = event.target
    if (!form.dataset || !form.dataset.addonCurrencyExample) return

    // Keep the example on the page so the params stay visible.
    event.preventDefault()

    const submitted = Array.from(new FormData(form).entries())
      .filter(([name]) => name && !["utf8", "_method", "authenticity_token"].includes(name))

    const output = document.querySelector("[data-addon-currency-example-output]")
    output.textContent = submitted.length ?
      submitted.map(([name, value]) => `${name}: ${JSON.stringify(value)}`).join("\n") :
      "Nothing was submitted."

    console.log("Submitted form data:", Object.fromEntries(submitted))
  })
<% end %>

