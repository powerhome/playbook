<%
  load Playbook.kit_path("form", "docs", "_sample_data.ruby").to_s
  demo_id = "defaults"
  input_types = PlaybookFormDocsSampleData.input_types
  default_key = PlaybookFormDocsSampleData.default_input_key
  select_choices = PlaybookFormDocsSampleData.select_choices
  dropdown_options = PlaybookFormDocsSampleData.dropdown_options
  typeahead_options = PlaybookFormDocsSampleData.typeahead_options
  collection = PlaybookFormDocsSampleData.collection
  tree_data = PlaybookFormDocsSampleData.tree_data("defaults")
  form_open_source = PlaybookFormDocsSampleData.form_open(scope: demo_id)
  form_close_source = PlaybookFormDocsSampleData.form_close
%>

<div data-form-docs-demo="<%= demo_id %>">
  <div hidden data-form-docs-open><%= raw render_code(form_open_source, "erb") %></div>
  <div hidden data-form-docs-close><%= raw render_code(form_close_source, "erb") %></div>
  <%= pb_rails("body", props: {
        text: "Select one or more inputs to add them to the form.",
        color: "light",
        margin_bottom: "xs",
      }) %>
  <%= pb_rails("flex", props: { gap: "xs", wrap: true, margin_bottom: "md" }) do %>
    <% input_types.each do |input_type| %>
      <div data-form-docs-pill="<%= input_type[:key] %>"
           role="button"
           tabindex="0"
           style="cursor: pointer">
        <%= pb_rails("pill", props: {
              text: input_type[:label],
              text_transform: "none",
              variant: input_type[:key] == default_key ? "primary" : "neutral",
            }) %>
      </div>
    <% end %>
  <% end %>

  <%= pb_rails("flex", props: PlaybookFormDocsSampleData.demo_panel_flex_props) do %>
    <%= pb_rails("flex/flex_item", props: PlaybookFormDocsSampleData.demo_panel_column_props) do %>
      <%= pb_rails("card", props: { padding: "md" }) do %>
      <%= pb_form_with(scope: :defaults, url: "", method: :get, html: { onsubmit: "return false;" }) do |form| %>
        <% input_types.each do |input_type| %>
          <div data-form-docs-panel="<%= input_type[:key] %>"
               style="<%= input_type[:key] == default_key ? "" : "display: none;" %>">
            <div data-form-docs-snippet hidden><%= raw render_code(
              PlaybookFormDocsSampleData.form_body_snippet(
                File.read(Playbook.kit_path("form", "docs", "snippets", "defaults_#{input_type[:key]}.txt"))
              ),
              "erb"
            ) %></div>
            <% case input_type[:key]
               when "text_field" %>
              <%= form.text_field :full_name, props: { label: "Full Name" } %>
            <% when "email_field" %>
              <%= form.email_field :email, props: { label: "Email" } %>
            <% when "number_field" %>
              <%= form.number_field :quantity, props: { label: "Quantity" } %>
            <% when "search_field" %>
              <%= form.search_field :project_number, props: { label: "Project Number" } %>
            <% when "password_field" %>
              <%= form.password_field :password, props: { label: "Password" } %>
            <% when "url_field" %>
              <%= form.url_field :website, props: { label: "Website" } %>
            <% when "textarea" %>
              <%= form.text_area :bio, props: { label: "Bio" } %>
            <% when "select" %>
              <%= form.select :favorite_color, select_choices,
                    props: { label: "Favorite Color", blank_selection: "Select one..." } %>
            <% when "collection_select" %>
              <%= form.collection_select :state, collection, :value, :name,
                    props: { label: "State", blank_selection: "Select one..." } %>
            <% when "dropdown" %>
              <%= form.dropdown_field "defaults[country]",
                    props: { label: "Country", options: dropdown_options } %>
            <% when "multi_select" %>
              <%= form.dropdown_field "defaults[countries]",
                    props: {
                      label: "Countries",
                      options: dropdown_options,
                      multi_select: true,
                    } %>
            <% when "checkbox" %>
              <%= form.check_box :newsletter,
                    props: { text: "Subscribe to newsletter", label: "Checkbox" },
                    checked_value: "yes",
                    unchecked_value: "no" %>
            <% when "date_picker" %>
              <%= form.date_picker :start_date, props: { label: "Start Date", allow_input: true } %>
            <% when "time_picker" %>
              <%= form.time_picker :start_time, props: { label: "Start Time" } %>
            <% when "time_zone_select" %>
              <%= form.time_zone_select_field :time_zone, ActiveSupport::TimeZone.us_zones,
                    { default: "Eastern Time (US & Canada)" },
                    props: { label: "Time Zone" } %>
            <% when "typeahead" %>
              <%= form.typeahead "defaults[color_search]",
                    props: {
                      options: typeahead_options,
                      pills: true,
                      label: "Favorite Color",
                      placeholder: "Search for a color",
                    } %>
            <% when "phone_number" %>
              <%= form.phone_number_field "defaults[phone]", props: { label: "Phone Number" } %>
            <% when "intl_telephone" %>
              <%= form.intl_telephone "defaults[intl_phone]", props: { label: "Intl Telephone" } %>
            <% when "star_rating" %>
              <%= form.star_rating_field "defaults[rating]",
                    props: { variant: "interactive", label: "Rating" } %>
            <% when "multi_level_select" %>
              <%= form.multi_level_select "defaults[department]",
                    props: {
                      id: "mls-defaults",
                      tree_data: tree_data,
                      margin_bottom: "sm",
                      label: "Department",
                    } %>
            <% end %>
          </div>
        <% end %>

        <%= form.actions do |action| %>
          <%= action.submit %>
          <%= action.button props: { type: "reset", text: "Cancel", variant: "secondary" } %>
        <% end %>
      <% end %>
      <% end %>
    <% end %>

    <%= pb_rails("flex/flex_item", props: PlaybookFormDocsSampleData.demo_panel_column_props) do %>
      <%= pb_rails("caption", props: { text: "Submitted Form Data", margin_bottom: "xs" }) %>
      <%= pb_rails("card", props: { background: "light", padding: "md" }) do %>
        <div data-form-docs-empty>
          <%= pb_rails("body", props: { text: "No data submitted yet.", color: "light" }) %>
        </div>
        <pre data-form-docs-output
             style="display: none; margin: 0; overflow: auto; font-size: 12px; line-height: 1.5; white-space: pre-wrap;"></pre>
      <% end %>
    <% end %>
  <% end %>

  <%= pb_rails("body", props: {
        text: "Submit the form to see the data on the right.",
        color: "light",
        margin_top: "sm",
        margin_bottom: "sm",
      }) %>

  <%= pb_rails("card", props: { background: "dark", dark: true, padding: "none" }) do %>
    <div class="pb--codeCopy pb--codeCopy_compact">
      <pre class="highlight" data-form-docs-code style="margin: 0; overflow: auto; font-size: 12px; line-height: 1.5; white-space: pre-wrap;"></pre>
    </div>
  <% end %>
</div>

<%= pb_rails("title", props: { size: 4, text: "Naming kit fields under a scope", margin_top: "md", margin_bottom: "sm" }) %>
<%= pb_rails("body", props: { tag: "div", margin_bottom: "sm" }) do %>
  <p><code>text_field</code>, <code>select</code>, <code>check_box</code>, and similar Rails-backed helpers nest under the form <code>scope</code> automatically (<code>defaults[full_name]</code> when <code>scope: :defaults</code>).</p>
  <p>Playbook-only helpers — <code>typeahead</code>, <code>phone_number_field</code>, and <code>dropdown_field</code> — do not. Pass an explicit string that matches the form scope so params stay nested:</p>
<% end %>
<%= pb_rails("card", props: { background: "dark", dark: true, padding: "none", margin_bottom: "sm" }) do %>
  <div class="pb--codeCopy pb--codeCopy_compact">
    <pre class="highlight" style="margin: 0; overflow: auto; font-size: 12px; line-height: 1.5; white-space: pre-wrap;"><%= raw render_code(
      File.read(Playbook.kit_path("form", "docs", "snippets", "defaults_scoped_fields.txt")),
      "erb"
    ) %></pre>
  </div>
<% end %>
<%= pb_rails("body", props: { text: "Submitted params then land under params[:defaults], matching the code you copy.", color: "light" }) %>

<script>
<%= raw File.read(Playbook.kit_path("form", "docs", "_form_docs_demo.js")) %>
PbFormDocsDemo("<%= demo_id %>")
</script>
