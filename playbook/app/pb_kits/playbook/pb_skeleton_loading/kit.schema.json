{
  "$schema": "https://playbook.powerapp.cloud/schemas/kit-schema.json",
  "name": "SkeletonLoading",
  "description": "SkeletonLoading component",
  "platforms": [
    "react",
    "rails"
  ],
  "props": {
    "height": {
      "type": "string",
      "platforms": [
        "react",
        "rails"
      ],
      "default": "16px"
    },
    "width": {
      "type": "string",
      "platforms": [
        "react",
        "rails"
      ],
      "default": "100%"
    },
    "borderRadius": {
      "type": "enum",
      "platforms": [
        "react",
        "rails"
      ],
      "values": [
        "none",
        "xs",
        "sm",
        "md",
        "lg",
        "xl",
        "rounded"
      ],
      "default": "sm"
    },
    "gap": {
      "type": "enum",
      "platforms": [
        "react",
        "rails"
      ],
      "values": [
        "none",
        "xxs",
        "xs",
        "sm",
        "md",
        "lg",
        "xl",
        "xxl"
      ],
      "default": "xxs"
    },
    "stack": {
      "type": "number",
      "platforms": [
        "react",
        "rails"
      ],
      "default": 1
    },
    "color": {
      "type": "enum",
      "platforms": [
        "react",
        "rails"
      ],
      "values": [
        "default",
        "white"
      ],
      "default": "default"
    },
    "dark": {
      "type": "boolean",
      "platforms": [
        "react",
        "rails"
      ],
      "default": false
    }
  },
  "globalProps": true,
  "usage": {
    "react": {
      "import": "import { SkeletonLoading } from 'playbook-ui'",
      "example": "<SkeletonLoading borderRadius=\"none\" gap=\"none\"></SkeletonLoading>"
    },
    "rails": {
      "import": null,
      "example": "<%= pb_rails(\"skeleton_loading\", props: { border_radius: \"none\", gap: \"none\" }) %>"
    }
  }
}
