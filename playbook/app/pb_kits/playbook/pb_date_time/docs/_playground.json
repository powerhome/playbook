{
  "template": "<DateTime{{props}} />",
  "propTargets": {},
  "defaults": {
    "align": "left",
    "size": "md",
    "showCurrentYear": false,
    "showDayOfWeek": false,
    "showIcon": false,
    "timeZone": "America/New_York"
  },
  "groups": [
    {
      "name": "Date Config",
      "props": [
        "datetime",
        "showDayOfWeek",
        "showCurrentYear",
        "showIcon",
        "timeZone",
        "date",
        "timezone"
      ]
    },
    {
      "name": "Appearance",
      "props": [
        "size",
        "align"
      ]
    }
  ],
  "presets": [
    {
      "name": "Default",
      "props": {
        "datetime": "2026-04-09T15:30:00.000Z"
      }
    },
    {
      "name": "Small",
      "props": {
        "datetime": "2026-04-09T15:30:00.000Z",
        "size": "sm"
      }
    },
    {
      "name": "With weekday",
      "props": {
        "datetime": "2026-06-12T11:00:00.000Z",
        "showDayOfWeek": true
      }
    },
    {
      "name": "With icon",
      "props": {
        "datetime": "2026-04-09T15:30:00.000Z",
        "showIcon": true,
        "size": "md"
      }
    },
    {
      "name": "Centered",
      "props": {
        "datetime": "2026-04-09T15:30:00.000Z",
        "align": "center"
      }
    },
    {
      "name": "Tokyo time",
      "props": {
        "datetime": "2026-04-09T15:30:00.000Z",
        "timeZone": "Asia/Tokyo"
      }
    },
    {
      "name": "Always show year",
      "props": {
        "datetime": "2026-04-09T15:30:00.000Z",
        "showCurrentYear": true
      }
    },
    {
      "name": "Date and time",
      "platforms": [
        "rails"
      ],
      "props": {
        "date": "2026-04-09T15:30:00Z"
      }
    },
    {
      "name": "Small with icon",
      "platforms": [
        "rails"
      ],
      "props": {
        "date": "2026-04-09T15:30:00Z",
        "size": "sm",
        "showIcon": true
      }
    },
    {
      "name": "Weekday & year",
      "platforms": [
        "rails"
      ],
      "props": {
        "date": "2026-06-12T11:00:00Z",
        "showDayOfWeek": true,
        "showCurrentYear": true
      }
    },
    {
      "name": "Tokyo timezone",
      "platforms": [
        "rails"
      ],
      "props": {
        "date": "2026-04-09T15:30:00Z",
        "timezone": "Asia/Tokyo"
      }
    }
  ],
  "conditionals": {},
  "hints": {
    "tokyo_time": {
      "presetName": "Tokyo time",
      "message": "Use the timeZone prop to display the time in a different timezone",
      "type": "info"
    },
    "tokyo_timezone": {
      "presetName": "Tokyo timezone",
      "message": "Use the timezone prop to display the time in a different timezone",
      "type": "info"
    }
  }
}
