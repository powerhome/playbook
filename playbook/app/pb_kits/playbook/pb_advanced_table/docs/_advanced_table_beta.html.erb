<% column_definitions = [
    {
      accessor: "time_of_day",
      label: "Time of Day (Local)",
      cellAccessors: ["territory"],
      custom_renderer: ->(row, value) { content_tag(:strong, "hello") },
    },
    {
      label: "Projected Issued Appointments",
      columns: [
        {
          accessor: "projected_non_same_day",
          label: "Non Same Day",
          custom_renderer: ->(row, value) { content_tag(:strong, "HIII") },
        },
        {
          accessor: "projected_same_day",
          label: "Same Day",
          custom_renderer: ->(row, value) { content_tag(:strong, "hihiiih") },
        },
        {
          accessor: "projected_total",
          label: "Total",
          custom_renderer: ->(row, value) { content_tag(:strong, "value") },
        },
      ],
    },
    {
      label: "Actual Issued Appointments",
      columns: [
        {
          accessor: "actual_non_same_day",
          label: "Non Same Day",
          custom_renderer: ->(row, value) { content_tag(:strong, "value") },
        },
        {
          accessor: "actual_same_day",
          label: "Same Day",
          custom_renderer: ->(row, value) { content_tag(:strong, "value") },
        },
        {
          accessor: "actual_total",
          label: "Total",
          custom_renderer: ->(row, value) { content_tag(:strong, "value") },
        },
      ],
    },
    {
      accessor: "difference",
      label: "Difference",
      custom_renderer: ->(row, value) { content_tag(:strong, "value") },
      header: ->(cell, label) {
        capture do
          pb_rails("flex", props: { align_items: "center", justify_content: "center" }) do
            pb_rails("caption", props: { margin_right: "xxs", text: "Difference" }) +
            pb_rails("icon", props: { id: "tooltip-difference", icon: "info-circle", size: "1x", color: "light", cursor: "pointer" }) +
            pb_rails("tooltip", props: {
              trigger_element_id: "tooltip-difference",
              tooltip_id: "difference-tooltip",
              position: "bottom",
              z_index: "10"
            }) do
              "Difference = Total Projected - Total Actual"
            end
          end
        end
      },
    },
] %>

<%= pb_rails("advanced_table", props: { id: "beta_table", table_data: @table_data, column_definitions: column_definitions }) %>
