<%
typeahead_suffix_tree_ids = lambda do |nodes, suffix|
  nodes.map do |node|
    child = node.dup
    child[:id] = "#{node[:id]}-#{suffix}"
    child[:children] = typeahead_suffix_tree_ids.call(node[:children], suffix) if node[:children]
    child
  end
end

