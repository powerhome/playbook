{
  "$schema": "https://playbook.powerapp.cloud/schemas/kit-schema.json",
  "name": "Container",
  "description": "Container component",
  "platforms": [
    "react",
    "rails"
  ],
  "props": {
    "tag": {
      "type": "enum",
      "platforms": [
        "react",
        "rails"
      ],
      "values": [
        "div",
        "span",
        "a",
        "button",
        "option",
        "table",
        "tbody",
        "thead",
        "tfoot",
        "tr",
        "td",
        "th",
        "img",
        "section",
        "article",
        "main",
        "header",
        "footer",
        "nav",
        "aside"
      ],
      "default": "div"
    }
  },
  "globalProps": true,
  "usage": {
    "react": {
      "import": "import { Container } from 'playbook-ui'",
      "example": "<Container tag=\"div\"></Container>"
    },
    "rails": {
      "import": null,
      "example": "<%= pb_rails(\"container\", props: { tag: \"div\" }) %>"
    }
  }
}
