#!/usr/bin/env bash

set -e

# Vite backwards compatibility
trap 'rm -f dist/menu.yml app/pb_kits/playbook/_playbook.scss app/pb_kits/playbook/_reset.scss' EXIT
cp ../playbook-website/config/menu.yml dist/menu.yml
awk '{sub(/kits\//,""); print}' app/entrypoints/playbook.scss > app/pb_kits/playbook/_playbook.scss
cp app/entrypoints/reset.scss app/pb_kits/playbook/_reset.scss

gem build playbook_ui.gemspec
