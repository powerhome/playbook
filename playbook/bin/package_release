#!/usr/bin/env bash

set -euo pipefail
cd "$(dirname "$0")/.."

npm_version=${1:?Expected npm version}
ruby_version=${2:?Expected RubyGems version}
npm_package="playbook-ui-${npm_version}.tgz"
ruby_package="playbook_ui-${ruby_version}.gem"

if [[ ${3:-} != --verify-only ]]; then
  node -e 'const pkg = require("./package.json"); if (pkg.version !== process.argv[1]) throw new Error("Unexpected npm version: " + pkg.version)' -- "$npm_version"
  ruby -r ./lib/playbook/version.rb -e 'abort "Unexpected gem version: #{Playbook::VERSION}" unless Playbook::VERSION == ARGV.fetch(0)' "$ruby_version"

  yarn release
  npm pack
  bin/build_gem
fi

tar -xOf "$npm_package" package/package.json | node -e '
  const pkg = JSON.parse(require("node:fs").readFileSync(0, "utf8"));
  if (pkg.name !== "playbook-ui" || pkg.version !== process.argv[1]) {
    throw new Error("Unexpected npm artifact: " + pkg.name + " " + pkg.version);
  }
' -- "$npm_version"

ruby -r rubygems/package -e '
  spec = Gem::Package.new(ARGV.fetch(0)).spec
  abort "Unexpected gem artifact: #{spec.full_name}" unless spec.name == "playbook_ui" && spec.version.to_s == ARGV.fetch(1)
' "$ruby_package" "$ruby_version"
